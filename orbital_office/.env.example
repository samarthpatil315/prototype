# Copy to .env.local for your own notes — NEVER commit real secrets.
# The mobile app only ever receives the PUBLIC anon key. Service-role keys
# and AI provider keys belong ONLY in Supabase Edge Function secrets.
#
# Pass config to Flutter with --dart-define (see docs/BUILD.md):
#   flutter run \
#     --dart-define=SUPABASE_URL=https://YOUR_PROJECT.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
#
# Leave both empty to run the fully-offline demo workspace.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Edge Function secrets (set with `supabase secrets set`, never in the app):
#   AI_PROVIDER_API_KEY=
#   AI_PROVIDER_MODEL=
